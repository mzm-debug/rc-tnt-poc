{
  "name": "RC TNT LangGraph",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "pip install -r requirements.txt && python -m app.seed_data",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "RC TNT UI",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
